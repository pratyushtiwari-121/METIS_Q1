# Frontend environment variables for Vite
# Copy this to frontend/.env.local for local overrides (never commit .env.local)

# --- PRODUCTION (Vercel) ---
# Set this in Vercel Dashboard > Project > Settings > Environment Variables
# Point it to the URL where your FastAPI backend is hosted (e.g. Render, Railway, Fly.io)
# Example:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# --- LOCAL DEVELOPMENT ---
# Leave VITE_API_BASE_URL unset (or comment it out).
# Vite will proxy /api → http://127.0.0.1:8000 automatically (see vite.config.ts).
# VITE_API_BASE_URL=
